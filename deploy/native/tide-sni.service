[Unit]
Description=Tide TLS SNI router
After=network-online.target tide-caddy.service
Wants=network-online.target

[Service]
User=www-data
Group=www-data
RuntimeDirectory=tide-sni
ExecStartPre=/usr/sbin/nginx -t -c /etc/tide/sni.conf -p /run/tide-sni/
ExecStart=/usr/sbin/nginx -c /etc/tide/sni.conf -p /run/tide-sni/ -g "daemon off;"
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=75M

[Install]
WantedBy=multi-user.target
